{
	"name": "sah",
	"displayName": "Static Analysis Hero",
	"publisher": "usdAG",
	"description": "Bringing code-reviews to the next level",
	"icon": "src/media/logo.png",
	"version": "2.0.2",
	"engines": {
		"vscode": "^1.99.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension",
	"contributes": {
		"configuration": {
			"properties": {
				"SAH.logLevel": {
					"type": "string",
					"default": "info",
					"enum": [
						"debug",
						"info",
						"warn",
						"error",
						"off"
					],
					"description": "Log level for SAH's output channel."
				}
			}
		},
		"commands": [
			{
				"command": "extension.newProject",
				"title": "SAH: New Project"
			},
			{
				"command": "extension.loadProject",
				"title": "SAH: Load Project"
			},
			{
				"command": "extension.showMatchesList",
				"title": "SAH: Show Matches List"
			},
			{
				"command": "extension.importSemgrepScan",
				"title": "SAH: Scan Code"
			},
			{
				"command": "fileExplorer.refresh",
				"title": "SAH: Refresh File Explorer"
			},
			{
				"command": "fileExplorer.excludeFile",
				"title": "SAH: Exclude File"
			},
			{
				"command": "fileExplorer.excludeFolder",
				"title": "SAH: Exclude Folder"
			},
			{
				"command": "fileExplorer.unexcludeFile",
				"title": "SAH: Unexclude File"
			},
			{
				"command": "fileExplorer.unexcludeFolder",
				"title": "SAH: Unexclude Folder"
			},
			{
				"command": "fileExplorer.excludeFileNode",
				"title": "SAH: Exclude File"
			},
			{
				"command": "fileExplorer.excludeFolderNode",
				"title": "SAH: Exclude Folder"
			},
			{
				"command": "fileExplorer.unexcludeFileNode",
				"title": "SAH: Unexclude File"
			},
			{
				"command": "fileExplorer.unexcludeFolderNode",
				"title": "SAH: Unexclude Folder"
			},
			{
				"command": "fileExplorer.showMatchesForFolder",
				"title": "SAH: Only show Matches in this path"
			},
			{
				"command": "fileExplorer.toggleHidden",
				"title": "SAH: Hide Excluded Files"
			},
			{
				"command": "fileExplorer.toggleVisible",
				"title": "SAH: Show Excluded Files"
			},
			{
				"command": "extension.saveProject",
				"title": "SAH: Save Project"
			},
			{
				"command": "fileExplorer.showMatchesForFile",
				"title": "SAH: Only show Matches for this file"
			},
			{
				"command": "fileExplorer.resetExclusion",
				"title": "SAH: Reset the Exclusion of all files/folders"
			},
			{
				"command": "fileExplorer.resetExclusionShortText",
				"title": "SAH: Reset Excludes"
			},
			{
				"command": "extension.deduplicateMatches",
				"title": "SAH: deduplicate Matches"
			},
			{
				"command": "SAH.setLogLevelDebug",
				"title": "SAH: Set Log Level to Debug"
			},
			{
				"command": "SAH.setLogLevelInfo",
				"title": "SAH: Set Log Level to Info"
			},
			{
				"command": "SAH.setLogLevelWarn",
				"title": "SAH: Set Log Level to Warn"
			},
			{
				"command": "SAH.setLogLevelError",
				"title": "SAH: Set Log Level to Error"
			},
			{
				"command": "SAH.setLogLevelOff",
				"title": "SAH: Set Log Level to Off"
			},
			{
				"command": "extension.showHelp",
				"title": "SAH: Show Help"
			},
			{
				"command": "extension.showMatchesTestSection",
				"title": "SAH: Scanning Sandbox"
			},
			{
				"command": "workspace.createFindingFromSelection",
				"title": "SAH: Create Match from Selection"
			}			
		],
		"keybindings": [],
		"menus": {
			"commandPalette": [
				{
					"command": "fileExplorer.showMatchesForFile",
					"when": "false"
				},
				{
					"command": "extension.deduplicateMatches",
					"when": "false"
				},
				{
					"command": "fileExplorer.resetExclusionShortText",
					"when": "false"
				},
				{
					"command": "fileExplorer.resetExclusion",
					"when": "false"
				},
				{
					"command": "fileExplorer.showMatchesForFile",
					"when": "false"
				},
				{
					"command": "fileExplorer.toggleVisible",
					"when": "false"
				},
				{
					"command": "fileExplorer.toggleHidden",
					"when": "false"
				},
				{
					"command": "fileExplorer.showMatchesForFolder",
					"when": "false"
				},
				{
					"command": "fileExplorer.unexcludeFolderNode",
					"when": "false"
				},
				{
					"command": "fileExplorer.unexcludeFileNode",
					"when": "false"
				},
				{
					"command": "fileExplorer.excludeFolderNode",
					"when": "false"
				},
				{
					"command": "fileExplorer.excludeFileNode",
					"when": "false"
				},
				{
					"command": "fileExplorer.unexcludeFolder",
					"when": "false"
				},
				{
					"command": "fileExplorer.unexcludeFile",
					"when": "false"
				},
				{
					"command": "fileExplorer.excludeFolder",
					"when": "false"
				},
				{
					"command": "fileExplorer.excludeFile",
					"when": "false"
				},
				{
					"command": "fileExplorer.refresh",
					"when": "false"
				}, 
				{
					"command": "workspace.createFindingFromSelection",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "fileExplorer.toggleHidden",
					"when": "view == fileExplorer && fileExplorer:showExcluded",
					"group": "navigation"
				},
				{
					"command": "fileExplorer.toggleVisible",
					"when": "view == fileExplorer && !fileExplorer:showExcluded",
					"group": "navigation"
				},
				{
					"command": "fileExplorer.resetExclusionShortText",
					"when": "view == fileExplorer",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "fileExplorer.excludeFileNode",
					"when": "view == fileExplorer",
					"group": "navigation"
				},
				{
					"command": "fileExplorer.unexcludeFileNode",
					"when": "view == fileExplorer",
					"group": "navigation"
				},
				{
					"command": "fileExplorer.excludeFolderNode",
					"when": "view == fileExplorer",
					"group": "navigation"
				},
				{
					"command": "fileExplorer.unexcludeFolderNode",
					"when": "view == fileExplorer",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "fileExplorer.showMatchesForFile",
					"when": "explorerResourceIsFolder == false",
					"group": "SAH@1"
				},
				{
					"command": "fileExplorer.showMatchesForFolder",
					"when": "explorerResourceIsFolder == true",
					"group": "SAH@1"
				},
				{
					"command": "fileExplorer.excludeFile",
					"when": "explorerResourceIsFolder == false",
					"group": "SAH@2"
				},
				{
					"command": "fileExplorer.excludeFolder",
					"when": "explorerResourceIsFolder == true",
					"group": "SAH@2"
				},
				{
					"command": "fileExplorer.unexcludeFile",
					"when": "explorerResourceIsFolder == false",
					"group": "SAH@3"
				},
				{
					"command": "fileExplorer.unexcludeFolder",
					"when": "explorerResourceIsFolder == true",
					"group": "SAH@3"
				},
				{
					"command": "fileExplorer.resetExclusion",
					"group": "SAH@4"
				}
			], 
			"editor/context": [
				{
					"command": "workspace.createFindingFromSelection",
					"group": "sah-workspace",
					"when": "editor.hasSelection"
				}
			]
		},
		"views": {
			"explorer": [
				{
					"id": "fileExplorer",
					"name": "File Explorer"
				}
			]
		},
		"colors": [
			{
				"id": "sah.criticalityInfo",
				"description": "Badge color for INFO criticality SAH matches",
				"defaults": { "dark": "#4da6ff", "light": "#0066cc", "highContrast": "#4da6ff", "highContrastLight": "#0055bb" }
			},
			{
				"id": "sah.criticalityLow",
				"description": "Badge color for LOW criticality SAH matches",
				"defaults": { "dark": "#ddcc00", "light": "#887700", "highContrast": "#ddcc00", "highContrastLight": "#776600" }
			},
			{
				"id": "sah.criticalityMedium",
				"description": "Badge color for MEDIUM criticality SAH matches",
				"defaults": { "dark": "#ff8c00", "light": "#cc5500", "highContrast": "#ff8c00", "highContrastLight": "#bb4400" }
			},
			{
				"id": "sah.criticalityHigh",
				"description": "Badge color for HIGH criticality SAH matches",
				"defaults": { "dark": "#e05050", "light": "#cc2222", "highContrast": "#ff6060", "highContrastLight": "#cc0000" }
			},
			{
				"id": "sah.criticalityCritical",
				"description": "Badge color for CRITICAL criticality SAH matches",
				"defaults": { "dark": "#ff2222", "light": "#bb0000", "highContrast": "#ff4444", "highContrastLight": "#aa0000" }
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.0.14",
		"@types/vscode": "^1.99.0",
		"@typescript-eslint/eslint-plugin": "^8.37.0",
		"@typescript-eslint/parser": "^8.37.0",
		"@vscode/vsce": "^3.6.0",
		"eslint": "^9.31.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-plugin-import": "^2.32.0",
		"glob": "^11.0.3",
		"globals": "^16.3.0",
		"mocha": "^11.7.1",
		"ts-loader": "^9.5.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0",
		"vscode-test": "^1.6.1",
		"webpack": "^5.100.2",
		"webpack-cli": "^6.0.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/usdAG/sah"
	},
	"dependencies": {
		"axios": "^1.10.0",
		"sanitize-html": "^2.17.0"
	}
}
